{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated NOVA user profile stored strictly under their own UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "AI Studio conversation thread owned by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "systemPrompt": {
          "type": "string",
          "maxLength": 1000
        },
        "messageCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "model", "messageCount", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message within an AI Studio chat session.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"],
          "maxLength": 16
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "chatId", "role", "content", "model", "createdAt"]
    },
    "ImageJob": {
      "title": "ImageJob",
      "description": "Image Studio generation job record and status.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "aspectRatio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "enum": ["queued", "processing", "completed", "failed"],
          "maxLength": 20
        },
        "thumbnailDataUrl": {
          "type": "string",
          "maxLength": 250000
        },
        "errorMessage": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "prompt", "model", "aspectRatio", "status", "createdAt", "updatedAt"]
    },
    "DownloadJob": {
      "title": "DownloadJob",
      "description": "Downloader inspection and download history record.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sizeBytes": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "failed", "unsupported"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "url", "filename", "mimeType", "sizeBytes", "status", "createdAt"]
    },
    "AnimeBookmark": {
      "title": "AnimeBookmark",
      "description": "User-saved anime entry from Anime Hub.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "animeId": {
          "type": "integer"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "coverImage": {
          "type": "string",
          "maxLength": 500
        },
        "format": {
          "type": "string",
          "maxLength": 32
        },
        "episodes": {
          "type": "integer"
        },
        "score": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "animeId", "title", "format", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document owned by userId."
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "AI Studio chat sessions for the user."
    },
    "/users/{userId}/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Ordered chat messages inside a user chat session."
    },
    "/users/{userId}/imageJobs/{jobId}": {
      "schema": { "$ref": "#/entities/ImageJob" },
      "description": "Image Studio generation job records."
    },
    "/users/{userId}/downloadJobs/{jobId}": {
      "schema": { "$ref": "#/entities/DownloadJob" },
      "description": "Media Downloader history entries."
    },
    "/users/{userId}/animeBookmarks/{animeId}": {
      "schema": { "$ref": "#/entities/AnimeBookmark" },
      "description": "Saved anime bookmarks from Anime Hub."
    }
  }
}
